{
  "name": "nocturna",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare-deploy": "node scripts/prepare-deploy.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nocturna --config tests/rules/firebase.json \"node --test tests/rules/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/eb-garamond": "5.2.7",
    "@fontsource/pirata-one": "5.2.7",
    "@phosphor-icons/web": "2.1.1",
    "firebase": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "14.27.0",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "0.21.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
