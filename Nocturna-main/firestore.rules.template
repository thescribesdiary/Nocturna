rules_version = '2';
// Regole di sicurezza di Nocturna.
// Questo file viene generato automaticamente: l'indirizzo autorizzato arriva da nocturna.config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni utente legge e scrive solo i propri dati, e solo l'account autorizzato può accedere.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == '__ALLOWED_EMAIL__';
    }
  }
}
