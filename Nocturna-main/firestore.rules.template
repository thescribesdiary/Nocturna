rules_version = '2';
// Regole di sicurezza di Nocturna.
// Questo file viene generato automaticamente: gli indirizzi autorizzati arrivano dal secret ALLOWED_EMAIL
// (uno o più indirizzi Google separati da virgola).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__ALLOWED_EMAILS__];
    }
    // «condiviso»: i dati comuni a tutti gli account autorizzati.
    // Lo spazio personale (uid) resta leggibile dal suo proprietario, per copiare i dati delle versioni precedenti.
    match /users/{space}/{document=**} {
      allow read, write: if autorizzato() && (space == 'condiviso' || space == request.auth.uid);
    }
  }
}
